        <ParameterSet>
          <Parameter name="INTEGRATION_US" type="IntegrationUsType" mode="sync" readOnly="false" offset="0x1000" unit="us"/>
          <Parameter name="DETECTOR_TEMP_RAW" type="DetectorTempRawType" mode="sync" readOnly="true" offset="0x1004" unit="K" cal_c0="180.0" cal_c1="0.05"/>
