{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeffadickson/StrataForge/manifests/schema/mission.schema.json",
  "title": "STRATA-20 Mission Manifest Schema",
  "description": "Single-source-of-truth declarative manifest for Versal and Kintex shared-FPGA flight missions.",
  "type": "object",
  "required": ["mission", "partitions"],
  "properties": {
    "mission": {
      "type": "object",
      "required": ["name", "target_silicon", "minor_frame_us", "major_frame_us"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "target_silicon": {
          "type": "string",
          "enum": ["XQRVC1902", "XQRVE2102", "XQRKU060", "XCKU060", "XCKU15P"]
        },
        "minor_frame_us": { "type": "integer", "minimum": 100 },
        "major_frame_us": { "type": "integer", "minimum": 100 }
      }
    },
    "partitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "criticality", "cpu", "budget_us"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "criticality": { "type": "string", "enum": ["CLASS_B", "CLASS_C", "CLASS_D"] },
          "cpu": { "type": "string", "minLength": 1 },
          "budget_us": { "type": "integer", "minimum": 1 },
          "cds_bytes": { "type": "integer", "minimum": 0 },
          "ram_base": { "type": "integer", "minimum": 0 },
          "ram_bytes": { "type": "integer", "minimum": 4096 }
        }
      }
    },
    "hw_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slot_id", "name", "mode", "owner_partition"],
        "properties": {
          "slot_id": { "type": "integer", "minimum": 0 },
          "name": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "enum": ["PL_SPATIAL", "PL_DFX", "VERSAL_AIE"] },
          "owner_partition": { "type": "string", "minLength": 1 },
          "scsr_phys_addr": { "type": "integer", "minimum": 0 },
          "noc_routing_group": {
            "type": "string",
            "enum": ["CRITICAL_EXCL", "SCIENCE_BEST_EFFORT"]
          },
          "quiesce_timeout_us": { "type": "integer", "minimum": 1 },
          "aie_columns": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "data_pools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "phys_base", "slot_count", "slot_bytes"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "phys_base": { "type": "integer", "minimum": 0 },
          "slot_count": { "type": "integer", "minimum": 2 },
          "slot_bytes": { "type": "integer", "minimum": 4096, "multipleOf": 4096 },
          "writer_slot": { "type": "integer", "minimum": 0 },
          "readers": { "type": "array", "items": { "type": "string" } },
          "lease_timeout_ms": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "pipelines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "stages"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "stages": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^(slot|part):[a-zA-Z0-9_]+$" }
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["opcode", "name", "owner_partition"],
        "properties": {
          "opcode": { "type": "integer", "minimum": 0, "maximum": 65535 },
          "name": { "type": "string", "minLength": 1 },
          "owner_partition": { "type": "string", "minLength": 1 },
          "min_role": { "type": "string" },
          "payload_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "telemetry": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["channel_id", "name", "owner_partition"],
        "properties": {
          "channel_id": { "type": "integer", "minimum": 0, "maximum": 65535 },
          "name": { "type": "string", "minLength": 1 },
          "owner_partition": { "type": "string", "minLength": 1 },
          "type": { "type": "string" },
          "unit": { "type": "string" },
          "cal_c0": { "type": "number" },
          "cal_c1": { "type": "number" }
        }
      }
    }
  }
}
